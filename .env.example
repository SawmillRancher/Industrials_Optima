# News API Key (get from https://newsapi.org/)
NEWSAPI_KEY=your_newsapi_key_here

# OpenAI API Key (optional, for AI summarization)
OPENAI_API_KEY=your_openai_key_here

# Anthropic API Key (optional, for AI summarization)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Summarizer type: extractive (default), openai, or anthropic
SUMMARIZER=extractive

# Maximum articles per topic
MAX_ARTICLES_PER_TOPIC=10

# Delivery time in 24h format (HH:MM)
DELIVERY_TIME=07:00

# Output directory for digest files
OUTPUT_DIR=./output

# Email settings (optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=recipient@example.com
